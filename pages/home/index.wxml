<pawly-nav brand="{{true}}" back="{{false}}" transparent="{{navClear}}">
  <view slot="right" class="nav-actions">
    <view class="nav-icon icon-search" bindtap="goSearch"></view>
    <view class="nav-icon icon-bell" bindtap="goNotify">
      <view class="nav-dot" wx:if="{{unreadNotify > 0}}"></view>
    </view>
  </view>
</pawly-nav>

<view class="home">
  <!-- —— 开场：暖调渐层 + 双色大标题 + AI 演示卡 —— -->
  <view class="hero">
    <view class="hero-wash"></view>
    <text class="hero-paw">🐾</text>
    <text class="deco deco-1">🎾</text>
    <text class="deco deco-2">🦴</text>
    <text class="deco deco-3">🐟</text>

    <view class="hero-inner">
      <view class="eyebrow hero-eyebrow fade-up">PAWLY · AI 宠物管家</view>
      <view class="h-display hero-title fade-up d-1">养宠不懂<text class="hero-br"></text>就问宝狸</view>
      <view class="h-display lite hero-title-2 fade-up d-2">答案有出处的 AI 管家</view>
      <view class="body hero-sub fade-up d-3">基于权威兽医指南　先把问题讲明白　再替你把东西挑对</view>

      <!-- AI 对话演示：点一下直接进 AI 管家 -->
      <view class="demo card fade-up d-4" bindtap="goAI" hover-class="demo-hover">
        <view class="demo-head">
          <view class="demo-ava">🐾</view>
          <view class="grow">
            <view class="demo-name">宝狸助手</view>
            <view class="caption">在线 · 平均 3 秒回复</view>
          </view>
          <view class="demo-live"></view>
        </view>
        <view class="demo-body">
          <view wx:for="{{demo}}" wx:key="role" class="bubble bubble-{{item.role}}">{{item.text}}</view>
        </view>
        <view class="demo-foot">
          <text class="demo-hint">问点什么…</text>
          <view class="demo-send"></view>
        </view>
      </view>

      <view class="hero-cta fade-up d-4">
        <view class="btn btn-primary btn-lg hero-btn" bindtap="goAI">让 AI 帮我挑 →</view>
        <view class="btn btn-ghost btn-lg hero-btn2" bindtap="goArticles">看科普</view>
      </view>
    </view>
  </view>

  <!-- —— 信任三则 —— -->
  <view class="trust">
    <view class="hairline"></view>
    <view wx:for="{{trust}}" wx:key="no" class="trust-item">
      <view class="row gap-16" style="align-items: baseline">
        <text class="mono trust-no">{{item.no}}</text>
        <text class="trust-t">{{item.t}}</text>
      </view>
      <view class="caption trust-d">{{item.d}}</view>
    </view>
    <view class="hairline"></view>
  </view>

  <!-- —— 章节 01 · 宠物科普 —— -->
  <section-head no="01" en="Pawly Journal" title="没人天生就会养宠物" action="所有文章" bind:action="goArticles" />
  <scroll-view class="h-scroll journal-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="h-scroll-inner">
      <article-card wx:for="{{journal}}" wx:key="id" a="{{item}}" mode="wide" bind:open="goArticle" />
    </view>
  </scroll-view>

  <!-- —— 分类索引 —— -->
  <view class="cats">
    <view wx:for="{{categories}}" wx:key="id" class="cat press" data-cat="{{item.id}}" bindtap="goShop">
      <text class="cat-icon">{{item.icon}}</text>
      <text class="cat-name">{{item.name}}</text>
    </view>
  </view>

  <!-- —— 章节 02 · 人气好物 —— -->
  <section-head no="02" en="Editor's Picks" title="本周人气好物" action="查看全部" bind:action="goShop" />
  <scroll-view class="h-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="h-scroll-inner">
      <product-card wx:for="{{featured}}" wx:key="id" p="{{item}}" mode="wide" bind:open="goProduct" bind:add="onAdd" />
    </view>
  </scroll-view>

  <!-- —— 会员 —— -->
  <view class="member-wrap">
    <view class="member press" bindtap="goMember">
      <text class="member-paw">🐾</text>
      <view class="eyebrow member-eyebrow">Pawly Club · 会员计划</view>
      <view class="member-title">把日常开销<text class="hero-br"></text>变成会员福利</view>
      <view class="member-desc">¥29/月 解锁全场 9 折、更多 AI 管家额度、生日礼盒，以及每年一次免费宠物体检。日常买粮买罐头省下的钱，往往就够回本。</view>
      <view class="member-grid">
        <view wx:for="{{perks}}" wx:key="t" class="perk">
          <text class="perk-e">{{item.e}}</text>
          <text class="perk-t">{{item.t}}</text>
        </view>
      </view>
      <view class="btn btn-accent member-btn">了解会员 →</view>
    </view>
  </view>

  <!-- —— 章节 03 · 新到货 —— -->
  <section-head no="03" en="New Arrivals" title="新到货" action="查看全部" bind:action="goShop" />
  <view class="grid-2">
    <product-card wx:for="{{newArrivals}}" wx:key="id" p="{{item}}" bind:open="goProduct" bind:add="onAdd" />
  </view>

  <view class="foot">
    <text class="foot-paw">🐾</text>
    <view class="caption foot-text">Made with 🐾 for 毛孩子 · Pawly 宝狸</view>
    <view class="caption foot-note">商品为演示数据，AI 回复仅供参考，宠物健康问题请咨询专业兽医</view>
  </view>

  <view class="tabbar-hold"></view>
</view>
