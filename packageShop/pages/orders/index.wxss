.od { padding: 24rpx 32rpx 0; }
.loading { padding: 80rpx 0; text-align: center; }
.order { margin-bottom: 24rpx; padding: 28rpx; }
.order-head { display: flex; align-items: flex-start; gap: 16rpx; }
.order-no { font-size: 24rpx; color: rgba(31, 42, 29, 0.66); }
.order-status {
  flex-shrink: 0; height: 44rpx; padding: 0 18rpx; border-radius: 999rpx;
  background: rgba(110, 152, 120, 0.16); color: #2C563A;
  font-size: 22rpx; font-weight: 600; line-height: 44rpx;
}
.order-items { margin-top: 22rpx; }
.oi { display: flex; align-items: center; gap: 18rpx; padding: 12rpx 0; }
.oi:active { opacity: 0.6; }
.oi-art { width: 88rpx; height: 88rpx; border-radius: 16rpx; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
.oi-emoji { font-size: 44rpx; }
.oi-name { font-size: 26rpx; font-weight: 600; }
.order-foot {
  margin-top: 18rpx; padding-top: 20rpx; border-top: 1rpx solid rgba(31, 42, 29, 0.06);
  display: flex; align-items: baseline; justify-content: flex-end; gap: 12rpx;
}
.order-total { font-size: 34rpx; font-weight: 700; }
