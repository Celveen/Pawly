.pf { padding-bottom: 20rpx; }
.edit-btn { padding: 8rpx 22rpx; border-radius: 999rpx; font-size: 24rpx; color: rgba(31, 42, 29, 0.66); border: 1rpx solid rgba(31, 42, 29, 0.12); }

.head { padding: 32rpx 32rpx 0; }
.head-top { display: flex; align-items: center; gap: 24rpx; }
.ava {
  width: 130rpx; height: 130rpx; border-radius: 999rpx; background: #F0E8D3; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center; overflow: hidden;
}
.ava-img { width: 100%; height: 100%; }
.ava-emoji { font-size: 64rpx; }
.pf-name { font-size: 38rpx; font-weight: 600; letter-spacing: -0.6rpx; }
.pf-id { margin-top: 6rpx; }
.pf-chips { margin-top: 14rpx; display: flex; flex-wrap: wrap; gap: 10rpx; }
.pf-bio { margin-top: 24rpx; font-size: 26rpx; }

.stats { margin-top: 28rpx; display: flex; }
.stat { flex: 1; padding: 22rpx 0; display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.stat:active { opacity: 0.6; }
.stat-n { font-size: 32rpx; font-weight: 700; }

.acts { margin-top: 12rpx; display: flex; gap: 16rpx; }
.act-btn { flex: 1; height: 84rpx; border-radius: 999rpx; }

.tabs {
  margin-top: 28rpx; display: flex; gap: 8rpx; padding: 0 32rpx;
  border-bottom: 1rpx solid rgba(31, 42, 29, 0.07);
}
.tab {
  position: relative; padding: 22rpx 20rpx; font-size: 27rpx; color: rgba(31, 42, 29, 0.5);
}
.tab-on { color: #1F2A1D; font-weight: 600; }
.tab-on::after {
  content: ''; position: absolute; left: 20rpx; right: 20rpx; bottom: -1rpx;
  height: 4rpx; border-radius: 999rpx; background: #DE7429;
}

.masonry { margin: 28rpx 24rpx 0; display: flex; gap: 16rpx; align-items: flex-start; }
.col { flex: 1; min-width: 0; }

.users { padding: 24rpx 32rpx 0; }
.user-row { display: flex; align-items: center; gap: 20rpx; padding: 24rpx 26rpx; margin-bottom: 16rpx; }
.u-ava {
  width: 84rpx; height: 84rpx; border-radius: 999rpx; background: #F0E8D3; flex-shrink: 0;
  font-size: 40rpx; line-height: 84rpx; text-align: center; overflow: hidden;
}
.u-name { font-size: 28rpx; font-weight: 600; }

.err { padding: 200rpx 60rpx; text-align: center; }
.err-emoji { font-size: 90rpx; }
.err-btn { margin-top: 32rpx; }
